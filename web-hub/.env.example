# Database
DATABASE_URL=postgres://shakti:shakti@localhost:5433/shakti_logistics

# JWT
ACCESS_TOKEN_SECRET=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-to-another-random-64-char-string
REFRESH_TOKEN_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limit (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=10
